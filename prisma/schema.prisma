generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String         @default("")
  status        String         @default("active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  artifacts     Artifact[]
  conversations Conversation[]

  @@map("projects")
}

model Artifact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  type      String
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ArtifactVersion[]

  @@index([projectId], map: "idx_artifacts_project_id")
  @@map("artifacts")
}

model ArtifactVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactId String   @map("artifact_id") @db.Uuid
  content    String
  note       String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId], map: "idx_artifact_versions_artifact_id")
  @@map("artifact_versions")
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  title     String    @default("Untitled")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([projectId], map: "idx_conversations_project_id")
  @@map("conversations")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  subagentId     String?  @map("subagent_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "idx_messages_conversation_id")
  @@map("messages")
}

model UserPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_preferences")
}